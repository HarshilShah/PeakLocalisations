    "Resolution Info" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Erhöhe deinen Aktivitätslevel schrittweise im Verlauf der Zeit, um deine langfristigen Ziele in einer nachhaltigen Art und Weise zu erreichen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gradually increase your activity levels over time to help you meet your long term goals in a sustainable manner"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aumenta gradualmente tus niveles de actividad con el tiempo para alcanzar tus objetivos a largo plazo de manera sostenible"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aumenta gradualmente i tuoi livelli di attività nel tempo per raggiungere i tuoi obiettivi a lungo termine in modo sostenibile"
          }
        }
      }
    },
