    "RestoreConfirmation.Body" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dies überschreibt all deine aktuellen Daten und Einstellungen.\n\nDiese Aktion kann nicht rückgängig gemacht werden."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This will overwrite all your current data and preferences.\n\nThis action cannot be undone."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esto sobrescribirá todos tus datos y preferencias actuales.\n\nEsta acción no se puede deshacer."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tutti i tuoi dati e le preferenze attuali verranno sovrascritti.\n\nQuesta azione non può essere annullata."
