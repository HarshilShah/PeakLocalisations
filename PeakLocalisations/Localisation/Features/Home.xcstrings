    "RemoveMetric.Body" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Diese Aktion kann nicht rückgängig gemacht werden und könnte Widgets, die %@ Daten anzeigen beeinträchtigen.\n\nDiese Änderung verändert nicht deine Daten in HealthKit."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This action cannot be undone, and may prevent your widgets configured to show %@ data from working.\n\nThis change does not affect your HealthKit data."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esta acción no se puede deshacer y puede impedir que tus widgets de %@ funcionen.\n\nEste cambio no afecta tus datos de HealthKit."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Questa azione non può essere annullata e potrebbe impedire il funzionamento dei widget configurati per mostrare i dati di %@.\n\nQuesta modifica non influisce sui tuoi dati di HealthKit."
          }
        }
      }
    },
