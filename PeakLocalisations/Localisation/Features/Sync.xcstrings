    "Explanation" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Peak synchronisiert und sichert deine Kennzahlen, Blöcke und Einstellungen in deinen iCloud-Account"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Peak syncs and backs up your metrics, blocks, and settings in your iCloud account"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Peak sincroniza y realiza copias de seguridad de tus métricas, bloques y configuraciones en tu cuenta de iCloud"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Peak sincronizza e crea copie di backup di metriche, blocchi e impostazioni nel tuo account iCloud"
          }
        }
      }
    },
