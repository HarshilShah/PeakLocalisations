{
  "sourceLanguage" : "en",
  "strings" : {
    "homescreen.add" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Homebildschirm-Widgets hinzufügen"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Adding Home Screen Widgets"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Agregar widgets de pantalla de inicio"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aggiungere widget alla schermata Home"
          }
        }
      }
    },
    "homescreen.addInstructions" : {
      "comment" : "Separate instructions with a single new line",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Drücke lange auf einen freien Bereich auf deinem Homebildschirm.\nTippe auf den Plus-Button oben links.\nSuche \"Peak\".\nWähle ein Widget aus und klicke auf \"Hinzufügen\".\nTippe auf das Widget, um es zu bearbeiten."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "On your Home Screen, long press in an empty space\nTap the plus button in the top left\nFind “Peak”\nPick a widget, and tap “Add Widget”\nTap the widget to edit it"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En tu pantalla de inicio, mantén presionado un espacio vacío\nToca el botón más en la parte superior izquierda\nEncuentra \"Peak\"\nElige un widget y toca \"Agregar widget\"\nToca el widget para editarlo"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sulla schermata Home, tocca e tieni premuto uno spazio vuoto\nTocca il pulsante '+' in alto a sinistra\nCerca \"Peak\"\nScegli un widget e tocca \"Aggiungi widget\"\nTocca il widget per modificarlo"
          }
        }
      }
    },
    "homescreen.edit" : {
      "extractionState" : "manual",
      "localizations" : {
