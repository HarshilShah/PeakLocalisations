            "value" : "Editar widgets de pantalla de inicio"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Modificare widget della schermata Home"
          }
        }
      }
    },
    "homescreen.editInstructions" : {
      "comment" : "Separate instructions with a single new line",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tippe lange auf ein Widget.\nWähle \"Widget bearbeiten\" aus."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Long press on the widget\nSelect “Edit Widget”"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mantén presionado el widget\nSelecciona \"Editar widget\""
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tieni premuto il widget\nSeleziona \"Modifica widget\""
          }
        }
      }
    },
    "lockscreen.add" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sperrbildschirm-Widgets hinzufügen"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Adding Lock Screen Widgets"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Agregar widgets de pantalla de bloqueo"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aggiungere widget alla schermata di blocco"
          }
        }
      }
    },
    "lockscreen.addInstructions" : {
      "comment" : "Separate instructions with a single new line",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Drücke lange auf einen freien Bereich auf deinem Sperrbildschirm.\nTippe auf \"Anpassen\".\nWähle den Sperrbildschirm aus.\nWähle ein Rechteck über oder unter der Zeit aus.\nSuche \"Peak\".\nWähle eines der Widgets aus um es hinzuzufügen (Hinweis: Du musst eventuell existierende Widgets entfernen, wenn nicht genug Platz vorhanden ist).\nTippe auf das Widget, um es zu bearbeiten."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "On your Lock Screen, long press in an empty space\nTap the “Customize” button\nSelect the Lock Screen\nSelect the rectangle above or below the time\nFind “Peak”\nTap any widget to add it (Note: You may need to remove existing widgets if there isn’t enough space)\nTap your newly added widget to edit it"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En tu pantalla de bloqueo, mantén presionado un espacio vacío\nToca el botón \"Personalizar\"\nSelecciona la pantalla de bloqueo\nSelecciona el rectángulo arriba o debajo de la hora\nBusca \"Peak\"\nToca cualquier widget para agregarlo (Nota: es posible que necesites eliminar widgets existentes si no hay suficiente espacio)\nToca tu widget recién agregado para editarlo"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sulla schermata di blocco, tocca e tieni premuto uno spazio vuoto\nTocca il pulsante \"Personalizza\"\nSeleziona la schermata di blocco\nSeleziona il riquadro sopra o sotto l'ora\nCerca \"Peak\"\nTocca qualsiasi widget per aggiungerlo (Nota: potrebbe essere necessario rimuovere widget esistenti se non c'è abbastanza spazio)\nTocca il widget appena aggiunto per modificarlo"
          }
        }
      }
    },
    "lockscreen.addInstructionsPad" : {
      "comment" : "Separate instructions with a single new line",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Drücke lange auf einen freien Bereich auf deinem Sperrbildschirm.\nTippe auf \"Anpassen\".\nWähle den Sperrbildschirm aus.\nWähle ein Rechteck über der Zeit oder links aus.\nSuche \"Peak\".\nWähle eines der Widgets aus um es hinzuzufügen (Hinweis: Du musst eventuell existierende Widgets entfernen, wenn nicht genug Platz vorhanden ist).\nTippe auf das Widget, um es zu bearbeiten."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "On your Lock Screen, long press in an empty space\nTap the “Customize” button\nSelect the Lock Screen\nSelect the rectangle above the time, or on the left\nFind “Peak”\nTap any widget to add it (Note: You may need to remove existing widgets if there isn’t enough space)\nTap your newly added widget to edit it"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En tu pantalla de bloqueo, mantén presionado un espacio vacío\nToca el botón \"Personalizar\"\nSelecciona la pantalla de bloqueo\nSelecciona el rectángulo arriba de la hora o a la izquierda\nBusca \"Peak\"\nToca cualquier widget para agregarlo (Nota: es posible que necesites eliminar widgets existentes si no hay suficiente espacio)\nToca tu widget recién agregado para editarlo"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sulla schermata di blocco, tocca e tieni premuto uno spazio vuoto\nTocca il pulsante \"Personalizza\"\nSeleziona la schermata di blocco\nSeleziona il riquadro sopra l'ora o a sinistra\nCerca \"Peak\"\nTocca qualsiasi widget per aggiungerlo (Nota: potrebbe essere necessario rimuovere widget esistenti se non c'è abbastanza spazio)\nTocca il widget appena aggiunto per modificarlo"
          }
        }
      }
    },
