    },
    "standBy.editInstructions" : {
      "comment" : "Separate instructions with a single new line",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aktiviere StandBy und wechsle zu einer Ansicht mit einem Peak Widget.\nHalte das Widget lange gedrückt, bis eine vertikales Karussell erscheint.\nTippe auf das Widget im Karussell, um es zu bearbeiten."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Enter StandBy mode, and scroll to a view with a Peak widget\nTap and hold on the widget until a vertical carousel appears\nTap the widget in the carousel to edit it"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Entra en modo En reposo y desplázate hasta una vista con un widget de Peak\nMantén presionado el widget hasta que aparezca un carrusel vertical\nToca el widget en el carrusel para editarlo"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Entra in modalità Standby e scorri fino a una vista con un widget di Peak\nTieni premuto il widget finché non compare un carosello verticale\nTocca il widget nel carosello per modificarlo"
          }
        }
      }
    },
    "standBy.enter" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "StandBy aktivieren"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Entering StandBy Mode"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Entrar en modo En reposo"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Attivare la modalità Standby"
          }
        }
      }
    },
    "standBy.enterInstructions" : {
      "comment" : "Separate instructions with a single new line",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hinweis: StandBy funktioniert nur auf einem iPhone mit iOS 17 oder neuer.\nGehe in die Einstellungen > StandBy und stelle sicher, dass StandBy aktiviert ist.\nVerbinde dein iPhone mit einem Ladegerät und kippe es in eine horizontale Position.\nDrücke den Seitenschalter.\nStreiche links oder rechts, um zwischen den verschiedenen Ansichten zu wechseln. Streiche hoch oder runter, um zwischen den verschiedenen Optionen der Ansichten zu wechseln."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Note: StandBy mode only works on iPhone, and requires iOS 17 or later\nGo to Settings > StandBy and make sure StandBy is turned on\nConnect your iPhone to a charger and set it down on its side\nTap the side button\nSwipe left or right to switch between different views. Swipe up or down to scroll between options for each of these views"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nota: el modo En reposo solo funciona en el iPhone y requiere iOS 17 o posterior\nVe a Configuración > En reposo y asegúrate de que esté activado\nConecta tu iPhone a un cargador y colócalo de lado\nPresiona el botón lateral\nDesliza hacia la izquierda o hacia la derecha para cambiar entre diferentes vistas. Desliza hacia arriba o hacia abajo para desplazarte entre las opciones de cada una de estas vistas"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nota: la modalità Standby funziona solo su iPhone e richiede iOS 17 o versioni successive\nVai su Impostazioni > Standby e assicurati che sia attivato\nCollega il tuo iPhone a un caricabatterie e posizionalo in orizzontale\nPremi il tasto laterale\nScorri verso sinistra o verso destra per passare da una vista all'altra. Scorri verso l'alto o verso il basso per scegliere le opzioni per ciascuna vista"
          }
        }
      }
    },
    "title" : {
      "extractionState" : "manual",
      "localizations" : {
