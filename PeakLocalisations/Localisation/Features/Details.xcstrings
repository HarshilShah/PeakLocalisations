    "RemoveBlock.Body" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Diese Aktion kann nicht rückgängig gemacht werden und könnte deine Widgets beeinträchtigen.\n\nDiese Änderung verändert nicht deine Daten in HealthKit."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This action cannot be undone, and may prevent your widgets from working.\n\nThis change does not affect your HealthKit data."
