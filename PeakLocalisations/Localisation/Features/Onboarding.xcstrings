    "Privacy.Body" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deine Gesundheitsdaten sind besonders sensibel, weshalb Peak keine Nutzerdaten sammelt."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Your health data is extremely sensitive, so Peak doesn’t collect any user data."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tus datos de salud son extremadamente confidenciales y, por eso, Peak no recopila ningún dato del usuario."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I tuoi dati sanitari sono estremamente sensibili, per questo Peak non raccoglie alcun dato utente."
          }
        }
      }
